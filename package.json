{
  "name": "3d-pcb-maker",
  "private": true,
  "version": "0.1.0",
  "description": "Turn Gerber + Excellon files into 3D-printable circuit boards for copper tape or conductive filament.",
  "license": "MIT",
  "author": "Ronald Mourik",
  "homepage": "https://ronaldmourik.github.io/3d_pcb_maker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronaldmourik/3d_pcb_maker.git"
  },
  "bugs": {
    "url": "https://github.com/ronaldmourik/3d_pcb_maker/issues"
  },
  "keywords": [
    "pcb",
    "gerber",
    "kicad",
    "3d-printing",
    "copper-tape",
    "opencascade",
    "step"
  ],
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-occt.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-occt.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "occt-import-js": "^0.0.22",
    "online-3d-viewer": "^0.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
